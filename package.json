{
  "name": "golf-league",
  "version": "0.1.0",
  "private": true,
  "description": "Season-long one-and-done golf league: picks, scoring, and side pots, run over the web.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:datagolf": "node scripts/verify-datagolf.mjs",
    "seed-admin": "node scripts/seed-admin.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "vitest": "^2.1.4",
    "@types/node": "^22.7.5"
  },
  "dependencies": {
    "googleapis": "^171.0.0"
  }
}
